@model ProfileViewModel
@{
    ViewData["Title"] = T["Profile.Title"];
}

<div class="max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight text-ink">@T["Profile.Title"]</h1>

    <form asp-action="Index" method="post" class="mt-6 space-y-5 rounded-lg border border-gray-200 bg-white p-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <h2 class="text-sm font-semibold text-ink">@T["Profile.PersonalInfo"]</h2>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="label">@T["Auth.FirstName"]</label>
                <input asp-for="FirstName" class="input" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>
            <div>
                <label asp-for="LastName" class="label">@T["Auth.LastName"]</label>
                <input asp-for="LastName" class="input" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>
        </div>

        <div>
            <label asp-for="Email" class="label">@T["Auth.Email"]</label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="Language" class="label">@T["Profile.Language"]</label>
            <select asp-for="Language" class="input">
                <option value="en" selected="@(Model.Language.StartsWith("en"))">English</option>
                <option value="es" selected="@(Model.Language.StartsWith("es"))">Español</option>
                <option value="it" selected="@(Model.Language.StartsWith("it"))">Italiano</option>
            </select>
        </div>

        <div class="flex gap-3 border-t border-gray-100 pt-4">
            <button type="submit" class="btn btn-primary">@T["Common.Save"]</button>
        </div>
    </form>

    <div class="mt-6 rounded-lg border border-gray-200 bg-white p-6">
        <h2 class="text-sm font-semibold text-ink">@T["Profile.ChangePassword"]</h2>
        <p class="mt-1 text-sm text-muted"><a href="/profile/password" class="font-medium text-primary hover:underline">@T["Profile.ChangePassword"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
