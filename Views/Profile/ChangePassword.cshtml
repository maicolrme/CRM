@model ChangePasswordViewModel
@{
    ViewData["Title"] = T["Profile.ChangePassword"];
}

<div class="max-w-md">
    <h1 class="text-2xl font-semibold tracking-tight text-ink">@T["Profile.ChangePassword"]</h1>

    <form asp-action="ChangePassword" method="post" class="mt-6 space-y-5 rounded-lg border border-gray-200 bg-white p-6">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="CurrentPassword" class="label">@T["Profile.CurrentPassword"]</label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="label">@T["Profile.NewPassword"]</label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="label">@T["Profile.ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>

        <div class="flex gap-3 border-t border-gray-100 pt-4">
            <button type="submit" class="btn btn-primary">@T["Common.Save"]</button>
            <a href="/profile" class="btn btn-secondary">@T["Common.Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
