@model DashboardViewModel
@{
    ViewData["Title"] = T["Navigation.Dashboard"];
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-ink">@T["Dashboard.Greeting"], @User.Identity?.Name</h1>
        <p class="mt-1 text-sm text-muted">@ViewData["Title"]</p>
    </div>
    <div class="flex gap-2">
        <a href="/customers/create" class="btn btn-primary">@T["Customer.Create"]</a>
        <a href="/tasks/create" class="btn btn-secondary">@T["Task.Create"]</a>
    </div>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-gray-200 bg-white p-5">
        <p class="text-sm font-medium text-muted">@T["Dashboard.Customers"]</p>
        <p class="mt-2 text-3xl font-semibold text-ink">@Model.TotalCustomers</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5">
        <p class="text-sm font-medium text-muted">@T["Dashboard.OpenTasks"]</p>
        <p class="mt-2 text-3xl font-semibold text-ink">@Model.OpenTasks</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5">
        <p class="text-sm font-medium text-muted">@T["Dashboard.Activities"]</p>
        <p class="mt-2 text-3xl font-semibold text-ink">@Model.TotalActivities</p>
    </div>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-gray-200 bg-white">
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3.5">
            <h2 class="text-sm font-semibold text-ink">@T["Dashboard.RecentCustomers"]</h2>
            <a href="/customers" class="text-xs font-medium text-primary hover:underline">@T["Dashboard.ViewAll"]</a>
        </div>
        @if (!Model.RecentCustomers.Any())
        {
            <p class="px-5 py-6 text-sm text-muted">@T["Customer.Empty"]</p>
        }
        else
        {
            <ul class="divide-y divide-gray-100">
                @foreach (var c in Model.RecentCustomers)
                {
                    <li class="flex items-center justify-between px-5 py-3">
                        <a href="/customers/@c.Id" class="text-sm font-medium text-ink hover:text-primary">@c.FullName</a>
                        <span class="text-xs text-muted">@c.Company?.Name</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="rounded-lg border border-gray-200 bg-white">
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3.5">
            <h2 class="text-sm font-semibold text-ink">@T["Dashboard.UpcomingTasks"]</h2>
            <a href="/tasks" class="text-xs font-medium text-primary hover:underline">@T["Dashboard.ViewAll"]</a>
        </div>
        @if (!Model.UpcomingTasks.Any())
        {
            <p class="px-5 py-6 text-sm text-muted">@T["Dashboard.NoTasks"]</p>
        }
        else
        {
            <ul class="divide-y divide-gray-100">
                @foreach (var t in Model.UpcomingTasks)
                {
                    <li class="flex items-center justify-between gap-3 px-5 py-3">
                        <span class="text-sm text-ink">@t.Title</span>
                        <span class="shrink-0 text-xs @(t.DueDate < DateTime.UtcNow ? "text-red-600" : "text-muted")">
                            @(t.DueDate?.ToShortDateString() ?? "—")
                        </span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<section class="mt-6 rounded-lg border border-gray-200 bg-white">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3.5">
        <h2 class="text-sm font-semibold text-ink">@T["Dashboard.RecentActivities"]</h2>
        <a href="/activities" class="text-xs font-medium text-primary hover:underline">@T["Dashboard.ViewAll"]</a>
    </div>
    @if (!Model.RecentActivities.Any())
    {
        <p class="px-5 py-6 text-sm text-muted">@T["Dashboard.NoActivities"]</p>
    }
    else
    {
        <ul class="divide-y divide-gray-100">
            @foreach (var a in Model.RecentActivities)
            {
                <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3">
                    <div>
                        <p class="text-sm font-medium text-ink">@a.Title</p>
                        <p class="text-xs text-muted">@a.Customer?.FullName</p>
                    </div>
                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">@T[$"Activity.Type.{a.Type}"]</span>
                </li>
            }
        </ul>
    }
</section>
