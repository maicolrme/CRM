@model AdminUserViewModel
@{
    ViewData["Title"] = T["Admin.EditUser"];
}

<div class="max-w-2xl">
    <p class="text-sm text-muted"><a href="/admin/users" class="hover:text-primary">@T["Navigation.Users"]</a></p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-ink">@T["Admin.EditUser"]</h1>

    <form asp-action="UserEdit" asp-route-id="@Model.Id" method="post" class="mt-6 space-y-5 rounded-lg border border-gray-200 bg-white p-6">
        @Html.AntiForgeryToken()

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="label">@T["Auth.FirstName"]</label>
                <input asp-for="FirstName" class="input" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>
            <div>
                <label asp-for="LastName" class="label">@T["Auth.LastName"]</label>
                <input asp-for="LastName" class="input" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>
        </div>

        <div>
            <label asp-for="Email" class="label">@T["Auth.Email"]</label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="space-y-3 border-t border-gray-100 pt-4">
            <label class="flex items-center gap-3">
                <input asp-for="IsAdmin" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
                <span class="text-sm text-ink">@T["Admin.MakeAdmin"]</span>
            </label>
            <label class="flex items-center gap-3">
                <input asp-for="IsActive" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
                <span class="text-sm text-ink">@T["Admin.IsActive"]</span>
            </label>
        </div>

        <div class="flex gap-3 border-t border-gray-100 pt-4">
            <button type="submit" class="btn btn-primary">@T["Common.Save"]</button>
            <a href="/admin/users" class="btn btn-secondary">@T["Common.Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
