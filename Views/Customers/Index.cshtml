@model CustomerListViewModel
@{
    ViewData["Title"] = T["Customer.Title"];
    string Badge(CustomerStatus s) => s switch
    {
        CustomerStatus.Lead => "bg-blue-50 text-blue-700 border-blue-200",
        CustomerStatus.Prospect => "bg-amber-50 text-amber-700 border-amber-200",
        CustomerStatus.Customer => "bg-green-50 text-green-700 border-green-200",
        _ => "bg-gray-100 text-gray-600 border-gray-200"
    };
}

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-ink">@T["Customer.Title"]</h1>
        <p class="mt-1 text-sm text-muted">@Model.Customers.Count</p>
    </div>
    <a href="/customers/create" class="btn btn-primary">@T["Customer.Create"]</a>
</div>

<form method="get" class="mt-5 flex flex-wrap gap-3">
    <input type="text" name="search" value="@Model.Search" placeholder="@T["Customer.Search"]"
           class="input max-w-md flex-1" />
    <select name="status" class="input max-w-[12rem]">
        <option value="">@T["Customer.Filter"]</option>
        @foreach (CustomerStatus s in Enum.GetValues<CustomerStatus>())
        {
            <option value="@((int)s)" selected="@(Model.Status == s)">@T[$"Customer.Status.{s}"]</option>
        }
    </select>
    <button type="submit" class="btn btn-secondary">@T["Common.Search"]</button>
</form>

<div class="mt-5 overflow-hidden rounded-lg border border-gray-200 bg-white">
    @if (!Model.Customers.Any())
    {
        <p class="px-5 py-10 text-center text-sm text-muted">@T["Customer.Empty"]</p>
    }
    else
    {
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-surface">
                <tr class="text-left text-xs font-semibold uppercase tracking-wider text-muted">
                    <th class="px-5 py-3">@T["Common.Name"]</th>
                    <th class="px-5 py-3">@T["Common.Email"]</th>
                    <th class="px-5 py-3">@T["Common.Company"]</th>
                    <th class="px-5 py-3">@T["Common.Status"]</th>
                    <th class="px-5 py-3 text-right">@T["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var c in Model.Customers)
                {
                    <tr class="hover:bg-surface">
                        <td class="px-5 py-3">
                            <a href="/customers/@c.Id" class="font-medium text-ink hover:text-primary">@c.FullName</a>
                        </td>
                        <td class="px-5 py-3 text-muted">@c.Email</td>
                        <td class="px-5 py-3 text-muted">@c.Company?.Name</td>
                        <td class="px-5 py-3">
                            <span class="inline-flex rounded-full border px-2 py-0.5 text-xs font-medium @Badge(c.Status)">
                                @T[$"Customer.Status.{c.Status}"]
                            </span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <a href="/customers/@c.Id/edit" class="btn btn-ghost btn-sm">@T["Common.Edit"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
