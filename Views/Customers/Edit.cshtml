@model CustomerFormViewModel
@{
    ViewData["Title"] = T["Customer.Edit"];
}

<div class="max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight text-ink">@T["Customer.Edit"]</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-6 space-y-5 rounded-lg border border-gray-200 bg-white p-6">
        @Html.AntiForgeryToken()

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="label">@T["Auth.FirstName"]</label>
                <input asp-for="FirstName" class="input" />
                <span asp-validation-for="FirstName" class="field-validation-error"></span>
            </div>
            <div>
                <label asp-for="LastName" class="label">@T["Auth.LastName"]</label>
                <input asp-for="LastName" class="input" />
                <span asp-validation-for="LastName" class="field-validation-error"></span>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="Email" class="label">@T["Common.Email"]</label>
                <input asp-for="Email" class="input" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div>
                <label asp-for="Phone" class="label">@T["Common.Phone"]</label>
                <input asp-for="Phone" class="input" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="CompanyId" class="label">@T["Common.Company"]</label>
                <select asp-for="CompanyId" asp-items="@(SelectList)ViewBag.Companies" class="input">
                    <option value="">—</option>
                </select>
            </div>
            <div>
                <label asp-for="Status" class="label">@T["Common.Status"]</label>
                <select asp-for="Status" asp-items="@(List<SelectListItem>)ViewBag.Statuses" class="input"></select>
            </div>
        </div>

        <div>
            <label asp-for="Notes" class="label">@T["Customer.Notes"]</label>
            <textarea asp-for="Notes" rows="4" class="input"></textarea>
        </div>

        <div class="flex gap-3 border-t border-gray-100 pt-4">
            <button type="submit" class="btn btn-primary">@T["Common.Save"]</button>
            <a href="/customers/@Model.Id" class="btn btn-secondary">@T["Common.Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
