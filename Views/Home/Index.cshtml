@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "CRM";
}

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-muted">
            ASP.NET Core MVC
        </span>
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-ink sm:text-5xl">
            CRM
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">
            @T["Home.Tagline"]
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/register" class="btn btn-primary px-5 py-2.5 text-sm">@T["Auth.Register"]</a>
            <a href="/login" class="btn btn-secondary px-5 py-2.5 text-sm">@T["Auth.Login"]</a>
        </div>
    </div>

    <div class="mt-16 border-t border-gray-200 pt-10">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">@T["Home.Features"]</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
            <div class="rounded-lg border border-gray-200 bg-white p-5">
                <div class="h-8 w-8 rounded-md bg-primary/10"></div>
                <h3 class="mt-4 text-base font-semibold text-ink">@T["Home.Feature1Title"]</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">@T["Home.Feature1Text"]</p>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-5">
                <div class="h-8 w-8 rounded-md bg-green-100"></div>
                <h3 class="mt-4 text-base font-semibold text-ink">@T["Home.Feature2Title"]</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">@T["Home.Feature2Text"]</p>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-5">
                <div class="h-8 w-8 rounded-md bg-amber-100"></div>
                <h3 class="mt-4 text-base font-semibold text-ink">@T["Home.Feature3Title"]</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">@T["Home.Feature3Text"]</p>
            </div>
        </div>
    </div>
</section>
